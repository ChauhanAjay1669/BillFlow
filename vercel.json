{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client/",
      "framework": "vite"
    },
    "server": {
      "root": "server/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server",
        "path": "/api/:path*"
      }
    },
    {
      "source": "/assets/:path*",
      "destination": {
        "service": "client",
        "path": "/assets/:path*"
      }
    },
    {
      "source": "/:file(.*\\.[a-zA-Z0-9]+)",
      "destination": {
        "service": "client",
        "path": "/:file"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "client",
        "path": "/index.html"
      }
    }
  ]
}
